# Configure estas variáveis na hospedagem (Netlify > Site configuration > Environment variables).
# Valem para o site e para o sistema: os dois usam o mesmo projeto Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica
# Opcional: Google Analytics 4 do site (ex.: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
